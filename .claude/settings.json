{
  "model": "sonnet",
  "autoCompactWindow": "100k",
  "permissions": {
    "allow": [
      "Bash", "Read", "Edit", "Write", "Glob", "Grep", "Agent", "WebSearch", "WebFetch",
      "Artifact", "ArtifactData", "SendUserFile", "Skill",
      "mcp__claude-code-remote", "mcp__github",
      "mcp__Gmail", "mcp__Google_Calendar", "mcp__Google_Drive"
    ],
    "deny": [
      "Read(parts/**/*.stl)", "Read(parts/**/*.glb)", "Read(parts/**/*.npz)",
      "Read(parts/**/log.txt)", "Read(parts/**/inputs/**)", "Read(site/meshes/**)",
      "Bash(git push --force*)", "Bash(git push -f*)"
    ]
  }
}
